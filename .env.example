# ==============================================================================
# AXY TECHNOLOGIES — ENVIRONMENT VARIABLES
# ==============================================================================
# For local development: copy to .env.local
# For Netlify deployment: add these in Netlify Dashboard > Site configuration > Environment variables
# ==============================================================================

# --- SUPABASE CONFIGURATION (REQUIRED) ---
# Supabase Project URL (from Supabase Dashboard > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Publishable Key (from Supabase Dashboard > Project Settings > API)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# --- RESEND EMAIL CONFIGURATION (OPTIONAL) ---
# Optional: Only needed if you want automatic email notifications on enquiry submission.
# If omitted or left empty, enquiry submissions will still be recorded safely in Supabase.
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM="AXY Technologies <notifications@yourverifieddomain.com>"
NOTIFICATION_EMAIL=axy.techh@gmail.com
